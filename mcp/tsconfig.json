{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "./ts-built",
    "sourceMap": true
  },
  "include": ["src", "../lib/utils"],
  "exclude": ["node_modules", "ts-built", "**/*.test.ts"]
}
