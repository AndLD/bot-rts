{
  "name": "bot-rts",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "lib",
    "api",
    "client"
  ],
  "scripts": {
    "format": "prettier --config .prettierrc.json --write .",
