#!/bin/sh
# The Git hook of every push (harness-framework): the vendored framework is checked (before anything else, documentation only or not), a protected
# or a deleted remote ref is refused, the project's setup script (`hooks.prePushSetup` of the profile file) is sourced, and the local gate runs.
# Git gives the refs of the push on standard input, and the name and address of the remote as arguments, which the gate does not need.
# The hook of a linked worktree gets GIT_DIR=<repo>/.git/worktrees/<name>: the setup script and the gate run without the variables that point Git at
# a repository, so a test that runs Git in a folder of its own does not act on this one (from the top folder, Git finds the repository by itself).
here=$(cd "$(dirname "$0")" && pwd -P)
# `core.hooksPath` is one absolute path, the main checkout's, so a linked worktree runs this file too: its own tools are used when it has them
# (the same path below its top folder), else its generated files would be checked against the `core/` of another tree.
top=$(git rev-parse --show-toplevel) || exit 1
main=$(cd "$(git rev-parse --git-common-dir)/.." && pwd -P)
case "$here" in "$main"/*) [ -f "$top${here#"$main"}/../harness.mjs" ] && here="$top${here#"$main"}" ;; esac
harness="$here/../harness.mjs"
cd "$top" || exit 1
input=$(cat)

if [ -f harness.lock.json ]; then node "$harness" check vendored || exit 1; fi
printf '%s\n' "$input" | node "$harness" guard pre-push || exit 1
unset $(git rev-parse --local-env-vars)

setup=$(node "$harness" profile get hooks.prePushSetup 2>/dev/null || true)
if [ -n "$setup" ] && [ -f "$setup" ]; then . "./$setup"; fi

printf '%s\n' "$input" | exec node "$harness" gate
