# Copy to api/.env.development and adjust. Never commit real values.
NODE_ENV=development
PORT=8080
WHITELIST_URLS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# PostgreSQL from `npm run db:up` (docker-compose.yml); used by Prisma and the integration tests
DATABASE_URL=postgresql://botrts:botrts@localhost:5432/botrts

# MongoDB (replaced by DATABASE_URL when the PostgreSQL layer lands)
MONGO_DB_URI=mongodb://localhost:27017
MONGO_DB_NAME=bot-rts

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=24h
JWT_EMAIL_VERIFICATION_SECRET=change-me-email
JWT_EMAIL_VERIFICATION_EXPIRES_IN=24h

# Rate limit of signup, login and refresh (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# SMTP (host defaults to smtp.gmail.com outside production; required in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Root user created on first start
ROOT_USER_EMAIL=root@root.root
ROOT_USER_PASSWORD=
