{
  "roles": ["owner", "admin", "moderator", "analyst"],
  "permissions": [
    { "permission": "dashboard.read", "roles": ["owner", "admin", "moderator", "analyst"] },
    { "permission": "alerts.acknowledge", "roles": ["owner", "admin"] },
    { "permission": "players.read", "roles": ["owner", "admin", "moderator"] },
    { "permission": "players.ban", "roles": ["owner", "admin", "moderator"] },
    { "permission": "players.logout", "roles": ["owner", "admin", "moderator"] },
    { "permission": "players.resend-verification", "roles": ["owner", "admin", "moderator"] },
