{
  "apps": [
    {
      "name": "bot-rts-node",
      "script": "npm",
      "args": ["run", "prod"],
      "cwd": "./api",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "1G",
      "env": {
        "NODE_ENV": "production"
      }
    },
    {
      "name": "bot-rts-react",
      "script": "npm",
      "args": ["run", "start"],
      "cwd": "./client",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "1G",
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}
