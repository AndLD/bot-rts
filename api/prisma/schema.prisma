// Persistence model. Prisma is confined to the infrastructure layer (AGENTS.md §3.4): this schema, the migrations and the
// generated client are imported only by the Prisma* adapters. Ids are UUIDs owned by the domain, never generated here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  admin
  owner
  moderator
  analyst
  user
  unlimited
  banned

  @@map("user_status")
}

enum Subscription {
  free
  monthly
  yearly

  @@map("subscription")
}

enum BotType {
  base
  // An ordinary bot, owned by a base
  worker

  @@map("bot_type")
}

enum MapPointType {
  resource
  bot
  item
  base
  corpse_base

  @@map("map_point_type")
}

enum ResourceType {
  iron
  stone
  wood
  oil
  crystal
  gold

  @@map("resource_type")
}

enum TerminalLogKind {
  input
  output
  error
  security

  @@map("terminal_log_kind")
}

enum AuthTokenKind {
  email_verification
  password_reset
  email_change
  account_deletion

  @@map("auth_token_kind")
}

// Who the player is in the game. Logins live elsewhere: `identities` links an external or custom login to a user, and
// the secrets of the custom provider are in `local_credentials` (AGENTS.md §3.3). Roles and bans are only read here.
model User {
  id                     String       @id @db.Uuid
  name                   String
  email                  String       @unique
  status                 UserStatus   @default(user)
  subscription           Subscription @default(free)
  createdAt              DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime?    @map("updated_at") @db.Timestamptz(3)
  // The privacy policy the player accepted at sign-up (design §15.3)
  privacyAcceptedVersion String?      @map("privacy_accepted_version")
  privacyAcceptedAt      DateTime?    @map("privacy_accepted_at") @db.Timestamptz(3)
  // Set when the player deleted the account: personal data is erased, the row stays for the player's base
  deletedAt              DateTime?    @map("deleted_at") @db.Timestamptz(3)
  // Set when the player was told by email that the account is erased for inactivity (data lifecycle, Phase 8.4)
  inactivityNoticeAt     DateTime?    @map("inactivity_notice_at") @db.Timestamptz(3)

  identities           Identity[]
  credential           LocalCredential?
  sessions             Session[]
  authTokens           AuthToken[]
  bases                Bot[]
  knownPoints          KnownPoint[]
  spawnSeedMemberships SpawnSeedMember[]
  terminalSessions     TerminalSession[]
  blueprints           Blueprint[]
  executions           Execution[]
  settings             UserSetting?
  achievementCounters  AchievementCounter[]
  achievementUnlocks   AchievementUnlock[]
  notifications        PlayerNotification[]
  apiKeys              ApiKey[]
  twoFactor            AdminTwoFactor?
  bans                 PlayerBan[]
  notes                PlayerNote[]

  @@index([createdAt])
  @@map("users")
}

// (provider, subject) -> user, for every identity provider ("local" for the custom credentials)
model Identity {
  id        String   @id @db.Uuid
  provider  String
  subject   String
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("identities")
}

// Owned by the custom (local) identity provider only
model LocalCredential {
  userId        String   @id @map("user_id") @db.Uuid
  passwordHash  String   @map("password_hash")
  emailVerified Boolean  @default(false) @map("email_verified")
  updatedAt     DateTime @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("local_credentials")
}

// A login of the custom provider; the refresh token is stored only as a hash and rotates on every refresh
model Session {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent        String?   @map("user_agent")

  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminVerification    AdminSessionVerification?

  @@index([userId])
  @@map("sessions")
}

// Single-use links emailed by the custom provider; only the hash of the token is stored
model AuthToken {
  id        String        @id @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  kind      AuthTokenKind
  tokenHash String        @unique @map("token_hash")
  // The address a pending email change moves to
  newEmail  String?       @map("new_email")
  createdAt DateTime      @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("auth_tokens")
}

// Only bases carry `userId`; an ordinary bot belongs to a base through `baseId` (design §8.1).
// The CHECK constraint `bots_ownership_check` lives in the migration SQL because Prisma cannot express it.
model Bot {
  id           String  @id @db.Uuid
  label        String?
  type         BotType
  userId       String? @map("user_id") @db.Uuid
  baseId       String? @map("base_id") @db.Uuid
  // The hash of the access password others need to connect (design §11.2.2); a base always has one
  passwordHash String? @map("password_hash")
  // Where the bot was when its last module was taken apart (design §8.4.1); set together or not at all, the CHECK
  // constraint `bots_last_position_check` lives in the migration SQL
  lastX        Int?    @map("last_x")
  lastY        Int?    @map("last_y")
  lastZ        Int?    @map("last_z")
  // The way the bot faces: a quarter turn clockwise from north, 0..3 (design §10.2); the CHECK constraint
  // `bots_heading_check` lives in the migration SQL
  heading      Int     @default(0)

  user                 User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  base                 Bot?              @relation("BaseBots", fields: [baseId], references: [id], onDelete: Cascade)
  bots                 Bot[]             @relation("BaseBots")
  modules              Module[]
  terminalSessions     TerminalSession[]
  connectedSessions    TerminalSession[] @relation("ConnectedFrom")
  access               BotAccess?
  terminalLogs         TerminalLog[]
  spawnSeedMemberships SpawnSeedMember[]
  items                Item[]
  executions           Execution[]

  @@index([userId, type])
  @@index([baseId])
  @@map("bots")
}

model Module {
  id            String @id @db.Uuid
  botId         String @map("bot_id") @db.Uuid
  type          String
  name          String
  condition     Float
  maxCondition  Float  @map("max_condition")
  weight        Float
  operationCost Float  @map("operation_cost")
  idleCost      Float  @map("idle_cost")
  // Type-specific properties (damage, capacity, …); the shape depends on `type`
  props         Json   @default("{}")

  bot   Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)
  files File[]

  @@index([botId, type])
  @@map("modules")
}

enum FileKind {
  file
  directory

  @@map("file_kind")
}

// A file or directory on a drive (a memory module); `path` runs from the root of the drive
model File {
  id      String   @id @db.Uuid
  driveId String   @map("drive_id") @db.Uuid
  path    String
  kind    FileKind @default(file)
  content String   @default("")
  // Bytes of `content`, kept for the quota
  size    Int      @default(0)

  drive Module @relation(fields: [driveId], references: [id], onDelete: Cascade)

  @@unique([driveId, path])
  @@map("files")
}

// The real (authoritative) layer of the world map
model MapPoint {
  id        String        @id @db.Uuid
  x         Int
  y         Int
  z         Int           @default(0)
  type      MapPointType?
  contentId String?       @map("content_id") @db.Uuid
  // A deposit: what it holds and how much is left (set only on resource cells)
  resource  ResourceType?
  amount    Int?

  @@unique([x, y, z])
  @@index([contentId])
  // Bases in an area (spawn placement, the map of bases) and the count of bases
  @@index([type, x, y])
  @@map("map_points")
}

// What a player knows about a cell: a snapshot taken at `seenAt` (game tick), design §4.2
model KnownPoint {
  id        String        @id @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  x         Int
  y         Int
  z         Int           @default(0)
  type      MapPointType?
  contentId String?       @map("content_id") @db.Uuid
  resource  ResourceType?
  amount    Int?
  seenAt    BigInt        @default(0) @map("seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, x, y, z])
  @@map("known_points")
}

// One connection to a bot's terminal; its lines are in `terminal_logs` (design §11.2)
model TerminalSession {
  id        String    @id @db.Uuid
  botId     String    @map("bot_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  startedAt DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)
  // The bot the player connected from when the session is on another bot (design §11.2.2); `adopt` assigns the bot to its base
  fromBotId String?   @map("from_bot_id") @db.Uuid

  bot     Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  fromBot Bot?          @relation("ConnectedFrom", fields: [fromBotId], references: [id], onDelete: SetNull)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs    TerminalLog[]

  @@index([botId, startedAt])
  @@index([userId])
  @@map("terminal_sessions")
}

model TerminalLog {
  id        String          @id @db.Uuid
  sessionId String          @map("session_id") @db.Uuid
  botId     String          @map("bot_id") @db.Uuid
  at        DateTime        @db.Timestamptz(3)
  kind      TerminalLogKind
  text      String

  session TerminalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  bot     Bot             @relation(fields: [botId], references: [id], onDelete: Cascade)

  // Reading a bot's newest lines, and the retention clean-up by age
  @@index([botId, at])
  @@index([at])
  @@map("terminal_logs")
}

// A code that lets players start near each other; the first deploy with it sets the anchor (design §22.3)
model SpawnSeed {
  code      String   @id
  anchorX   Int      @map("anchor_x")
  anchorY   Int      @map("anchor_y")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  members SpawnSeedMember[]

  @@map("spawn_seeds")
}

// The players of a seed, each with the base they started with
model SpawnSeedMember {
  seedCode String @map("seed_code")
  userId   String @map("user_id") @db.Uuid
  baseId   String @map("base_id") @db.Uuid

  seed SpawnSeed @relation(fields: [seedCode], references: [code], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  Bot       @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@id([seedCode, userId])
  @@index([baseId])
  @@map("spawn_seed_members")
}

enum ItemType {
  blueprint
  ammunition
  part

  @@map("item_type")
}

// A discrete object (design §9.1). It is carried by a bot (`botId`) or lies on the map, where a map point of type item
// points at it; a blueprint item's `name` is the module it holds the blueprint of.
model Item {
  id     String   @id @db.Uuid
  type   ItemType
  name   String
  weight Float
  botId  String?  @map("bot_id") @db.Uuid

  bot Bot? @relation(fields: [botId], references: [id], onDelete: SetNull)

  @@index([botId])
  @@map("items")
}

enum BlueprintSource {
  research
  item

  @@map("blueprint_source")
}

// A blueprint a player learned (design §9.3); the class-1 base set is known without a row
model Blueprint {
  userId    String          @map("user_id") @db.Uuid
  module    String
  source    BlueprintSource
  learnedAt DateTime        @map("learned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, module])
  @@map("blueprints")
}

enum ExecutionStatus {
  active
  finished
  killed

  @@map("execution_status")
}

// A script run on a bot (design §12.3, §12.3.1). The engine is its only writer; an execution that is still active after
// an engine restart is relaunched from the beginning of `main`.
model Execution {
  id        String          @id @db.Uuid
  botId     String          @map("bot_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  // The script file as `/<drive>/<path>` on the bot's drives
  file      String
  args      Json
  status    ExecutionStatus
  // How often the engine relaunched it after an unclean stop; reaching the limit kills it (crash-loop guard)
  restarts  Int             @default(0)
  reason    String?
  createdAt DateTime        @map("created_at") @db.Timestamptz(3)
  endedAt   DateTime?       @map("ended_at") @db.Timestamptz(3)

  bot  Bot  @relation(fields: [botId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What a restarted engine relaunches, oldest first; `top` of a player
  @@index([status, createdAt])
  @@index([userId, status])
  @@index([endedAt])
  @@map("executions")
}

// The failed password attempts on a bot and the lockout they led to (design §11.2.2)
model BotAccess {
  botId       String    @id @map("bot_id") @db.Uuid
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("bot_access")
}

// The settings of the whole game as key/value rows (design §15.1); a key that has no row has its default
model GameSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@map("game_settings")
}

// The settings of one player, as the player set them (design §15.1, §15.2)
model UserSetting {
  userId                 String   @id @map("user_id") @db.Uuid
  // The switches of the categories of manual control, by category; one that is not there is on
  manualCategories       Json     @default("{}") @map("manual_categories")
  reducedMotion          Boolean? @map("reduced_motion")
  // How far the player is in the tutorial: its status and the steps done (design §16.1)
  tutorial               Json     @default("{}")
  // The categories of notifications the player switched off, by category; one that is not there is on (design §24.2)
  notificationCategories Json     @default("{}") @map("notification_categories")
  updatedAt              DateTime @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// What the game counts for a player (design §23.1): one row per counter, only ever growing
model AchievementCounter {
  userId    String   @map("user_id") @db.Uuid
  counter   String
  value     BigInt   @default(0)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, counter])
  @@map("achievement_counters")
}

// The achievements a player has earned, and when
model AchievementUnlock {
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @map("unlocked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("achievement_unlocks")
}

// What the game told a player, kept for a limited time (design §24.2). A notification for something that finishes later waits with
// `deliveredAt` empty until its time.
model PlayerNotification {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  category    String
  // The translation key of the text, and its parameters
  kind        String
  params      Json      @default("{}")
  botId       String?   @map("bot_id")
  count       Int       @default(1)
  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([deliveredAt, createdAt])
  @@map("player_notifications")
}

// A key of a player for a client that is not the game's own (design §22.1). The secret is shown once and only its hash is stored.
model ApiKey {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String
  // The first characters of the key, to tell keys apart in the list
  prefix        String
  keyHash       String    @unique @map("key_hash")
  scopes        String[]
  ratePerMinute Int       @map("rate_per_minute")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("api_keys")
}

// The TOTP secret of an admin (design §25.2), encrypted at rest. The factor counts only once `enabledAt` is set.
model AdminTwoFactor {
  userId             String    @id @map("user_id") @db.Uuid
  secretEncrypted    String    @map("secret_encrypted")
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  enabledAt          DateTime? @map("enabled_at") @db.Timestamptz(3)
  // The time step of the last accepted code, so a code cannot be used twice
  lastUsedStep       BigInt?   @map("last_used_step")
  recoveryCodeHashes String[]  @map("recovery_code_hashes")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_two_factors")
}

// A session that passed the second factor; it ends with the session or when the verification expires
model AdminSessionVerification {
  sessionId  String   @id @map("session_id") @db.Uuid
  verifiedAt DateTime @map("verified_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("admin_session_verifications")
}

// Append-only record of what admins did (design §25.2). The trigger `admin_audit_log_append_only` in the migration SQL rejects
// updates and deletes. `actorId` has no foreign key on purpose: the trail outlives the account.
model AdminAuditEntry {
  id         String   @id @db.Uuid
  at         DateTime @db.Timestamptz(3)
  actorId    String   @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role")
  action     String
  outcome    String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  reason     String?
  before     Json?
  after      Json?
  ip         String?
  requestId  String?  @map("request_id")

  @@index([at])
  @@index([actorId, at])
  @@index([action, at])
  @@map("admin_audit_log")
}

// A ban from the admin console (design §25.3). The player's status is `banned` while a ban is active; `previousStatus` is what
// an unban gives back. `bannedBy` and `liftedBy` have no foreign key on purpose: they outlive the admin's account.
model PlayerBan {
  id             String     @id @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  bannedBy       String     @map("banned_by") @db.Uuid
  reason         String
  previousStatus UserStatus @map("previous_status")
  createdAt      DateTime   @map("created_at") @db.Timestamptz(3)
  // Null: until an admin lifts it
  expiresAt      DateTime?  @map("expires_at") @db.Timestamptz(3)
  liftedAt       DateTime?  @map("lifted_at") @db.Timestamptz(3)
  liftedBy       String?    @map("lifted_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([liftedAt, expiresAt])
  @@map("player_bans")
}

// An admin's note about a player, visible to admins only
model PlayerNote {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  text      String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("player_notes")
}

// Every sign-in attempt of the custom provider, for the security page of the admin console (design §25.3). `userId` is set for a
// successful one only; the email is what was typed. Old rows are removed by the data lifecycle job.
model LoginAttempt {
  id        String   @id @db.Uuid
  at        DateTime @db.Timestamptz(3)
  email     String
  userId    String?  @map("user_id") @db.Uuid
  ip        String?
  userAgent String?  @map("user_agent")
  outcome   String

  @@index([at])
  @@index([ip, at])
  @@index([userId, at])
  @@map("login_attempts")
}

// A version of the balance of the game, edited from the admin console (design §25.3). The document holds only what differs from
// the defaults of the server. Versions are never changed: a rollback is a new version with the document of an older one. The
// active one is named by the game setting `balance.active`, and the server takes it at its start.
model BalanceVersion {
  version   Int      @id @default(autoincrement())
  document  Json
  reason    String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@map("balance_versions")
}
