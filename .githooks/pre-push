#!/bin/sh
# The Git hook of every push: the hook of the vendored framework checks the vendored tree, refuses a push to a protected branch and the deletion of a
# remote branch, sources scripts/pre-push-setup.sh (hooks.prePushSetup) and runs the local gate (`harness gate`; docs/testing/README.md).
# Never bypass it with `git push --no-verify`: that flag is the owner's, for an emergency, and is recorded in the log of the task
# (docs/testing/README.md, "Bypassing the gate"). When the database cannot start, the gate says what to do.
exec sh "$(git rev-parse --show-toplevel)/harness/tools/git-hooks/pre-push" "$@"
