{
  "roles": ["owner", "admin", "moderator", "analyst"],
  "permissions": [
    { "permission": "dashboard.read", "roles": ["owner", "admin", "moderator", "analyst"] },
    { "permission": "alerts.acknowledge", "roles": ["owner", "admin"] },
    { "permission": "players.read", "roles": ["owner", "admin", "moderator"] },
    { "permission": "players.ban", "roles": ["owner", "admin", "moderator"] },
    { "permission": "players.logout", "roles": ["owner", "admin", "moderator"] },
    { "permission": "players.resend-verification", "roles": ["owner", "admin", "moderator"] },
    { "permission": "players.reset-password", "roles": ["owner", "admin", "moderator"] },
    { "permission": "players.notes", "roles": ["owner", "admin", "moderator"] },
    { "permission": "players.change-role", "roles": ["owner"] },
    { "permission": "players.delete", "roles": ["owner"] },
    { "permission": "players.view-as", "roles": ["owner", "admin"] },
    { "permission": "inspector.read", "roles": ["owner", "admin", "moderator"] },
    { "permission": "inspector.files.read", "roles": ["owner", "admin"] },
    { "permission": "inspector.kill-execution", "roles": ["owner", "admin"] },
    { "permission": "inspector.reboot-bot", "roles": ["owner", "admin"] },
    { "permission": "map.read", "roles": ["owner", "admin", "moderator"] },
    { "permission": "supervision.read", "roles": ["owner", "admin", "moderator"] },
    { "permission": "supervision.quarantine", "roles": ["owner", "admin"] },
    { "permission": "supervision.support", "roles": ["owner"] },
    { "permission": "ops.pause-world", "roles": ["owner", "admin"] },
    { "permission": "ops.kill-switch", "roles": ["owner"] },
    { "permission": "ops.announce", "roles": ["owner", "admin"] },
    { "permission": "ops.restart-runtime", "roles": ["owner"] },
    { "permission": "ops.retention", "roles": ["owner", "admin"] },
    { "permission": "ops.game-time", "roles": ["owner", "admin"] },
    { "permission": "security.read", "roles": ["owner", "admin", "moderator"] },
    { "permission": "security.revoke-key", "roles": ["owner", "admin"] },
    { "permission": "economy.read", "roles": ["owner", "admin", "analyst"] },
    { "permission": "balance.write", "roles": ["owner", "admin"] },
    { "permission": "logs.read", "roles": ["owner", "admin"] },
    { "permission": "audit.read", "roles": ["owner", "admin"] },
    { "permission": "audit.export", "roles": ["owner", "admin"] },
    { "permission": "analytics.read", "roles": ["owner", "admin", "analyst"] },
    { "permission": "devtools.use", "roles": ["owner"] }
  ],
  "auditActions": [
    "admin.2fa.begin-enrollment",
    "admin.2fa.confirm-enrollment",
    "admin.2fa.verify",
    "alerts.acknowledge",
    "analytics.export",
    "audit.export",
    "balance.rollback",
    "balance.save",
    "devtools.advance-clock",
    "devtools.remove-test-players",
    "devtools.reset-database",
    "devtools.seed-world",
    "features.update",
    "game-time.leave-real-world",
    "game-time.set-day-length",
    "game-time.set-real-world",
    "game-time.set-time-of-day",
    "inspector.read-file",
    "logs.read-trace",
    "logs.search",
    "operations.announce",
    "operations.clear-banner",
    "operations.restart-runtime",
    "operations.set-banner",
    "players.add-note",
    "players.ban",
    "players.change-role",
    "players.delete",
    "players.force-logout",
    "players.resend-verification",
    "players.reset-password",
    "players.unban",
    "players.view-as.start",
    "retention.reset",
    "retention.update",
    "security.revoke-key",
    "settings.update-categories",
    "supervision.allow-scripts",
    "supervision.compensate",
    "supervision.grant-resources",
    "supervision.halt-scripts",
    "supervision.kill-execution",
    "supervision.pause-world",
    "supervision.quarantine",
    "supervision.reboot-bot",
    "supervision.release",
    "supervision.remove-resources",
    "supervision.restore-module",
    "supervision.resume-world"
  ],
  "alerts": [
    { "metric": "engine.up", "direction": "below", "red": 1 },
    { "metric": "engine.tickP95Ratio", "direction": "above", "yellow": 0.8 },
    { "metric": "engine.overrunRate", "direction": "above", "red": 0.01 },
    { "metric": "jobs.lifecycleAgeSeconds", "direction": "above", "yellow": 7200, "red": 86400 },
    { "metric": "jobs.lifecycleFailures", "direction": "above", "yellow": 0 },
    { "metric": "notifications.deliveryLagMs", "direction": "above", "yellow": 60000, "red": 300000 },
    { "metric": "notifications.emailFailures", "direction": "above", "yellow": 0 },
    { "metric": "infrastructure.logDiskUsedRatio", "direction": "above", "yellow": 0.8, "red": 0.95 },
    { "metric": "infrastructure.dataDiskUsedRatio", "direction": "above", "yellow": 0.8, "red": 0.95 },
    { "metric": "infrastructure.backupAgeSeconds", "direction": "above", "yellow": 100800, "red": 172800 },
    { "metric": "database.queryP95Ms", "direction": "above", "yellow": 250, "red": 1000 },
    { "metric": "database.connectionsRatio", "direction": "above", "yellow": 0.7, "red": 0.9 },
    { "metric": "engine.flushMs", "direction": "above", "red": 5000 },
    { "metric": "engine.flushLagMs", "direction": "above", "red": 5000 },
    { "metric": "scripts.maxWaitTicks", "direction": "above", "yellow": 50, "red": 200 },
    { "metric": "api.errorRate5xx", "direction": "above", "yellow": 0.01, "red": 0.05 },
    { "metric": "api.latencyP95Ms", "direction": "above", "yellow": 500, "red": 2000 },
    { "metric": "infrastructure.gatewayUp", "direction": "below", "yellow": 1 },
    { "metric": "infrastructure.gatewayQueueSize", "direction": "above", "yellow": 5000, "red": 9000 }
  ]
}
