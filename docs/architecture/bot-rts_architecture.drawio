        <mxCell id="lib" parent="backend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="lib (shared package)&lt;br&gt;types, ErrorCode, pure functions&lt;br&gt;no runtime deps" vertex="1"><mxGeometry height="80" width="300" x="1700" y="1030" as="geometry"/></mxCell>
        <mxCell id="docker" parent="backend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Docker image (api/Dockerfile)&lt;br&gt;APP_ROLE api | engine | all&lt;br&gt;docker-compose stack / PM2" vertex="1"><mxGeometry height="80" width="300" x="2060" y="1030" as="geometry"/></mxCell>
        <mxCell id="migr" parent="backend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Migrate (one-shot)&lt;br&gt;prisma migrate deploy" vertex="1"><mxGeometry height="80" width="220" x="2400" y="1030" as="geometry"/></mxCell>
        <mxCell id="ci" parent="backend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="CI: lint, typecheck, Jest 97 %, Cypress e2e,&lt;br&gt;import-boundary check" vertex="1"><mxGeometry height="80" width="300" x="2060" y="1160" as="geometry"/></mxCell>
        <mxCell id="ghcr" parent="backend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Release: GHCR image&lt;br&gt;bot-rts-api:version" vertex="1"><mxGeometry height="80" width="220" x="2400" y="1160" as="geometry"/></mxCell>
        <mxCell id="smtp" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Email API&lt;br&gt;(SMTP provider)" vertex="1"><mxGeometry height="60" width="200" x="466" y="1240" as="geometry"/></mxCell>
        <mxCell id="prom" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Metrics scraper (Prometheus)&lt;br&gt;Bearer METRICS_TOKEN" vertex="1"><mxGeometry height="60" width="200" x="698" y="1240" as="geometry"/></mxCell>
        <mxCell id="clerk" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="Auth Framework API&lt;br&gt;(Clerk, optional later)" vertex="1"><mxGeometry height="60" width="200" x="234" y="1240" as="geometry"/></mxCell>
        <mxCell id="alert" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="Alerts to owner by email&lt;br&gt;webhooks in backlog" vertex="1"><mxGeometry height="60" width="200" x="930" y="1240" as="geometry"/></mxCell>
        <mxCell id="github" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="GitHub Actions + Releases" vertex="1"><mxGeometry height="60" width="200" x="2280" y="1240" as="geometry"/></mxCell>
        <mxCell id="n_clean" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;size=17;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=20;spacingRight=20;" value="&lt;div&gt;&lt;b&gt;Layering rule NOTE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;presentation → application → domain. Infrastructure implements application ports. Domain imports no framework. Prisma lives only in infrastructure (import-boundary check in CI), so replacing the database means rewriting adapters only.&lt;/div&gt;" vertex="1"><mxGeometry height="170" width="460" x="2780" y="-200" as="geometry"/></mxCell>
        <mxCell id="n_oneapi" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;size=17;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=20;spacingRight=20;" value="&lt;div&gt;&lt;b&gt;One API for every client NOTE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The web client, third-party clients and the MCP server all use the same versioned /api/v1 (REST + WebSocket). No private endpoints. API keys only narrow the player's rights, never reach admin endpoints, and obey the same game rules.&lt;/div&gt;" vertex="1"><mxGeometry height="170" width="460" x="2780" y="0" as="geometry"/></mxCell>
        <mxCell id="n_write" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;size=17;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=20;spacingRight=20;" value="&lt;div&gt;&lt;b&gt;Single writer NOTE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The API tier never writes world tables. World-changing requests go to the engine as commands over Redis; reads come from PostgreSQL. No engine listening gives 503 at once.&lt;/div&gt;" vertex="1"><mxGeometry height="150" width="460" x="2780" y="200" as="geometry"/></mxCell>
        <mxCell id="n_tick" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;size=17;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=20;spacingRight=20;" value="&lt;div&gt;&lt;b&gt;Tick model NOTE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Scripts never touch the world: an API call spends ops and queues a command. All commands of a tick are collected, then applied in a seeded stable order, so conflicts are resolved in memory with no row locks. No Date.now() or Math.random() in game logic.&lt;/div&gt;" vertex="1"><mxGeometry height="190" width="460" x="2780" y="380" as="geometry"/></mxCell>
        <mxCell id="n_scale" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;size=17;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=20;spacingRight=20;" value="&lt;div&gt;&lt;b&gt;Scaling NOTE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;API tier scales horizontally, the engine vertically. The map is addressed in chunks so region sharding stays possible later. If the engine dies the game pauses until restart and reload from the last flush (about 1 s lost).&lt;/div&gt;" vertex="1"><mxGeometry height="170" width="460" x="2780" y="600" as="geometry"/></mxCell>
        <mxCell id="n_redis" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;size=17;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=20;spacingRight=20;" value="&lt;div&gt;&lt;b&gt;Infrastructure NOTE&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Redis is not a game cache. It carries engine requests and replies, Socket.IO rooms between nodes, and shared rate-limit counters.&lt;/div&gt;" vertex="1"><mxGeometry height="130" width="460" x="2780" y="800" as="geometry"/></mxCell>
        <mxCell id="ph10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="Market + Currency Service, order book, auctions (Phase 10)" vertex="1"><mxGeometry height="50" width="460" x="2780" y="960" as="geometry"/></mxCell>
        <mxCell id="ph10b" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="Chat + Transfers + Inbox (Phase 10)" vertex="1"><mxGeometry height="50" width="460" x="2780" y="1030" as="geometry"/></mxCell>
        <mxCell id="ph10l" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="Double-entry Ledger writer + reconciliation (Phase 10)" vertex="1"><mxGeometry height="50" width="460" x="2780" y="1100" as="geometry"/></mxCell>
        <mxCell id="ph9r" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="Analytics, Dev tools, Operations (Phase 9 rest)" vertex="1"><mxGeometry height="50" width="460" x="2780" y="1170" as="geometry"/></mxCell>
        <mxCell id="shard" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="Engine shards by map region (backlog)" vertex="1"><mxGeometry height="50" width="460" x="2780" y="1240" as="geometry"/></mxCell>
