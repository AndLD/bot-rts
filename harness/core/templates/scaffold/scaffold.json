{
  "description": "The core files the bootstrap writes once into a new project: each template of this folder, rendered with the profile file, and the path it is written to (a template of the roles it names).",
  "files": [
    {
      "template": "entry-file.md",
      "path": "{{paths.entryFile}}"
    },
    {
      "template": "readme.md",
      "path": "{{documents.readme}}"
    },
    {
      "template": "stack.md",
      "path": "{{documents.stack}}"
    },
    {
      "template": "rule-checks.md",
      "path": "{{documents.ruleChecks}}"
    },
    {
      "template": "plan-index.md",
      "path": "{{paths.planIndex}}"
    },
    {
      "template": "open-ended-phase.md",
      "path": "{{paths.phases}}/phase-{{plan.openEndedPhaseNumber}}-issues.md"
    },
    {
      "template": "phase-log.md",
      "path": "{{paths.phases}}/work-logs/phase-{{plan.openEndedPhaseNumber}}-log.md"
    },
    {
      "template": "changelog.md",
      "path": "{{paths.changelog}}"
    },
    {
      "template": "releasing.md",
      "path": "{{documents.releasing}}"
    },
    {
      "template": "harness-bindings.md",
      "path": "{{documents.harnessBindings}}"
    },
    {
      "template": "changelog-fragments-index.md",
      "path": "{{paths.changelogFragments}}/README.md"
    },
    {
      "template": "product-index.md",
      "path": "{{documents.specification}}"
    },
    {
      "template": "product-glossary.md",
      "path": "{{documents.glossary}}"
    },
    {
      "template": "product-register.md",
      "path": "{{productKnowledge.specification}}/{{productKnowledge.register}}"
    },
    {
      "template": "product-backlog.md",
      "path": "{{productKnowledge.specification}}/{{productKnowledge.backlog}}"
    },
    {
      "template": "gitignore",
      "path": ".gitignore",
      "lines": true
    },
    {
      "template": "env.example",
      "path": ".env.example"
    }
  ]
}
