{
  "name": "bot-rts",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "lib",
    "api",
    "client",
    "mcp"
  ],
  "scripts": {
    "format": "prettier --config .prettierrc.json --write .",
    "lint": "npm run lint --workspaces --if-present && npm run format:check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d --wait db redis",
    "db:down": "docker compose down",
    "obs:up": "docker compose --profile observability up -d --wait otel-collector",
    "obs:down": "docker compose --profile observability stop otel-collector elasticsearch",
    "db:reset": "docker compose down -v && docker compose up -d --wait db",
    "format:check": "prettier --config .prettierrc.json --check .",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "docs:check": "node scripts/check-markdown-links.mjs && node scripts/check-open-items.mjs && node scripts/check-glossary.mjs && node scripts/check-product-knowledge.mjs && node scripts/check-core-leaks.mjs && node scripts/check-changelog-fragments.mjs && node scripts/plan-summary.mjs --check",
    "check:boundaries": "npm run check:boundaries --workspaces --if-present",
    "postinstall": "npm run prisma:generate -w api",
    "i18n:check": "node scripts/check-i18n.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "e2e": "node scripts/e2e.mjs",
    "load": "node scripts/load-test.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "docs:generate": "npm run docs:generate -w api",
    "plan:log": "node scripts/plan-log.mjs",
    "plan:summary": "node scripts/plan-summary.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "pg": "^8.23.1",
    "prettier": "^3.3.3",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
