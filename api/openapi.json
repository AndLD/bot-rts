                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ModuleResponse"
                  }
                }
              }
            }
          },
          "default": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "bots"
        ]
      }
    },
    "/api/v1/bots/{id}/scan": {
      "post": {
        "operationId": "botsScan",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MapPointResponse"
                  }
                }
              }
            }
          },
          "default": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "bots"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "healthCheck",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "default": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseModel"
                }
              }
            }
          }
        },
        "summary": "Liveness and database readiness",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Bot RTS API",
    "description": "The one API of the game: the web client, third-party clients and the MCP server use it.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refreshToken"
      }
    },
    "schemas": {
      "ErrorResponseModel": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 403
          },
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "VALIDATION_FAILED",
              "CREDENTIALS_INVALID",
              "EMAIL_ALREADY_EXISTS",
              "EMAIL_NOT_VERIFIED",
              "USER_BANNED",
              "INVALID_TOKEN",
              "TOKEN_EXPIRED",
              "WRONG_PASSWORD",
              "SERVICE_UNAVAILABLE",
              "SPAWN_SEED_CLOSED",
              "SPAWN_SEED_FULL",
              "BASE_LOST",
              "BASE_ALREADY_EXISTS",
              "NO_FREE_LOCATION",
              "UNKNOWN_COMMAND",
              "COMMAND_USAGE",
              "NO_DRIVE_SELECTED",
              "DRIVE_FULL",
              "DRIVE_BROKEN",
              "ALREADY_EXISTS",
              "TERMINAL_SESSION_CLOSED",
              "TOO_MANY_REQUESTS",
              "INTERNAL_ERROR"
            ],
            "description": "Stable machine-readable code; clients branch on it"
          },
          "error": {
            "type": "string",
            "description": "The human-readable message"
          }
        },
        "required": [
          "statusCode",
          "code",
          "error"
        ]
      },
      "UserInfoResponse": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "status": {
            "type": "string",
            "enum": [
              "admin",
              "owner",
              "user",
              "unlimited",
              "banned"
            ]
          },
          "active": {
            "type": "boolean",
            "description": "The email is verified"
          },
          "subscription": {
            "type": "string",
            "enum": [
              "free",
              "monthly",
              "yearly"
            ]
          },
          "createdAt": {
            "type": "number",
            "description": "Milliseconds since the epoch"
          },
          "updatedAt": {
            "type": "number",
            "description": "Milliseconds since the epoch"
          }
        },
        "required": [
          "_id",
          "name",
          "email",
          "status",
          "active",
          "subscription",
          "createdAt"
        ]
      },
      "PaginationModel": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "results": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "results",
          "total"
        ]
      },
      "UsersMetaModel": {
        "type": "object",
        "properties": {
          "pagination": {
            "$ref": "#/components/schemas/PaginationModel"
          }
        },
        "required": [
          "pagination"
        ]
      },
      "UsersPageResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserInfoResponse"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/UsersMetaModel"
          }
        },
        "required": [
          "result",
          "meta"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "subscription": {
            "type": "string",
            "enum": [
              "free",
              "monthly",
              "yearly"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "admin",
              "owner",
              "user",
              "unlimited",
              "banned"
            ],
            "description": "Only an owner may change the status"
          }
        }
      },
      "UserUpdatedResponse": {
        "type": "object",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/UserInfoResponse"
          }
        },
        "required": [
          "result"
        ]
      },
      "StatisticsResponse": {
        "type": "object",
        "properties": {
          "usersByStatus": {
            "type": "object",
            "properties": {
              "admin": {
                "type": "integer"
              },
              "owner": {
                "type": "integer"
              },
              "user": {
                "type": "integer"
              },
              "unlimited": {
                "type": "integer"
              },
              "banned": {
                "type": "integer"
              }
            },
            "required": [
              "admin",
              "owner",
              "user",
              "unlimited",
              "banned"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When this server instance started"
          }
        },
        "required": [
          "startedAt"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "First and last name"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "AuthTokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "The access token; the refresh token travels in an HTTP-only cookie"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ChangeEmailDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "newEmail": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "password",
          "newEmail"
        ]
      },
      "PasswordDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          }
        },
        "required": [
          "password"
        ]
      },
      "DriveResponse": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "format": "uuid"
          },
          "botId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "What `cd` takes; unique among the drives of a bot"
          },
          "quota": {
            "type": "number",
            "description": "bytes"
          },
          "used": {
            "type": "number",
            "description": "bytes"
          }
        },
        "required": [
          "_id",
          "botId",
          "name",
          "quota",
          "used"
        ]
      },
      "FileResponse": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "format": "uuid"
          },
          "driveId": {
            "type": "string",
            "format": "uuid"
          },
          "path": {
            "type": "string",
            "description": "Slash-separated path from the root of the drive",
            "example": "scripts/mine.js"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory"
            ]
          },
          "size": {
            "type": "number",
            "description": "bytes"
          },
          "content": {
            "type": "string",
            "description": "Only when the file is read, not in listings"
          }
        },
        "required": [
          "_id",
          "driveId",
          "path",
          "kind",
          "size"
        ]
      },
      "WriteFileDto": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ]
      },
      "MakeDirectoryDto": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "DeployBaseDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 6,
            "maxLength": 64
          },
          "spawnSeed": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9-]{2,23}$",
            "example": "ALPHA-7K2"
          }
        },
        "required": [
          "password"
        ]
      },
      "BotResponse": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Only a base has an owner"
          },
          "baseId": {
            "type": "string",
            "format": "uuid",
            "description": "Any other bot belongs to a base"
          },
          "type": {
            "type": "string",
            "enum": [
              "base",
              "worker"
            ]
          }
        },
        "required": [
          "_id",
          "type"
        ]
      },
      "ModuleResponse": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "format": "uuid"
          },
          "botId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "engine",
              "weapon",
              "mining",
              "manipulator",
              "drive",
              "processor",
              "wirelessAdapter",
              "battery",
              "storage",
              "armor",
              "scanner",
              "generator",
              "factory",
              "gps"
            ]
          },
          "name": {
            "type": "string"
          },
          "condition": {
            "type": "number",
            "description": "Hit points left; 0 means broken"
          },
          "maxCondition": {
            "type": "number"
          },
          "weight": {
            "type": "number",
            "description": "kg"
          },
          "operationCost": {
            "type": "number"
          },
          "idleCost": {
            "type": "number"
          }
        },
        "required": [
          "_id",
          "botId",
          "type",
          "name",
          "condition",
          "maxCondition",
          "weight",
          "operationCost",
          "idleCost"
        ]
      },
      "LocationModel": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number",
            "description": "Reserved: the world is 2D"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "ResourceStackModel": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string",
            "enum": [
              "iron",
              "stone",
              "wood",
              "oil",
              "crystal",
              "gold"
            ]
          },
          "amount": {
            "type": "number",
            "description": "What is left of the deposit"
          }
        },
        "required": [
          "resource",
          "amount"
        ]
      },
      "MapPointResponse": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "format": "uuid"
          },
          "location": {
            "$ref": "#/components/schemas/LocationModel"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Set on a point of a player's knowledge"
          },
          "contentId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "type": {
            "type": "string",
            "enum": [
              "resource",
              "bot",
              "item",
              "base",
              "corpse_base"
            ],
            "nullable": true
          },
          "resource": {
            "$ref": "#/components/schemas/ResourceStackModel"
          },
          "seenAt": {
            "type": "number",
            "description": "The game tick the snapshot was taken at"
          }
        },
        "required": [
          "_id",
          "location",
          "contentId",
          "type"
        ]
      },
      "DeployedBaseResponse": {
        "type": "object",
        "properties": {
          "bot": {
            "$ref": "#/components/schemas/BotResponse"
          },
          "modules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModuleResponse"
            }
          },
          "mapPoint": {
            "$ref": "#/components/schemas/MapPointResponse"
          }
        },
        "required": [
          "bot",
          "modules",
          "mapPoint"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      }
    }
  }
}
