# Copy to api/.env.development and adjust. Never commit real values.
NODE_ENV=development
PORT=8080
# Origins allowed to call the API (CORS and Socket.IO). One wildcard is allowed in the first label of the host, for preview
# deployments: https://bot-rts-*.vercel.app (a bare https://*.vercel.app is refused)
WHITELIST_URLS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# PostgreSQL from `npm run db:up` (docker-compose.yml)
DATABASE_URL=postgresql://botrts:botrts@localhost:5432/botrts

# Authentication: `local` is the custom email + password provider
AUTH_PROVIDER=local
# Required in production
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=10m
# How long a token's owner is remembered between requests (ms, 0 = not at all). A ban or a logout takes effect this much later.
AUTH_CACHE_TTL_MS=2000
# How long a login lasts without being used (refresh token / session lifetime)
JWT_REFRESH_EXPIRES_IN=30d
# The refresh cookie: lax (default outside production) when the web client and the API share a registrable domain, none (default in
# production, needs HTTPS) when the client is on another site, for example *.vercel.app previews. COOKIE_DOMAIN is optional.
COOKIE_SAME_SITE=
COOKIE_DOMAIN=
# Set to true behind a reverse proxy so rate limits see the client address
TRUST_PROXY=false

# World generation (all optional)
WORLD_SEED=
WORLD_CHUNK_SIZE=16
WORLD_RESOURCE_CHANCE=0.2
# Where new bases appear (design §4.1): the distance to every other base, how many cells are tried, and the square
# around the origin they are drawn in (grows by the second value for every base)
WORLD_MIN_BASE_DISTANCE=30
WORLD_SPAWN_ATTEMPTS=50
WORLD_SPAWN_RADIUS=60
WORLD_SPAWN_RADIUS_PER_BASE=10
# Spawn seeds (design §22.3): how far from the anchor players start, how many a seed takes, how long it stays open
SPAWN_SEED_RADIUS=12
SPAWN_SEED_MAX_PLAYERS=8
SPAWN_SEED_TTL_HOURS=24
# JSON file that overrides the resource balance (spawn weight, deposit range, hardness per resource); optional
WORLD_RESOURCE_BALANCE_FILE=
# JSON file that overrides recipes (by module name) and crafting numbers, see README
CRAFTING_RECIPES_FILE=

# Game engine (design §12): the thread that runs scripts. ENGINE_ENABLED defaults to true except in NODE_ENV=test.
ENGINE_ENABLED=
ENGINE_TICK_INTERVAL_MS=100
# Wall-clock time one script may use per tick before it is killed, and the share of the tick the engine may work
ENGINE_SLICE_MS=5
ENGINE_TICK_CAP_RATIO=0.8
ENGINE_FLUSH_EVERY_TICKS=10
# A write that fails this often in a row is given up on and the memory is reloaded from the database
ENGINE_FLUSH_MAX_FAILURES=3
ENGINE_SCRIPT_MEMORY_BYTES=4194304
ENGINE_SCRIPT_STACK_BYTES=65536
# The engine thread is ended, and the script it was inside killed, after this long in one step of a script (ms), checked this often
ENGINE_WATCHDOG_STALL_MS=2000
ENGINE_WATCHDOG_POLL_MS=250
# What a script's log may carry per tick (lines) and per line (characters)
ENGINE_LOG_MAX_LINES_PER_TICK=20
ENGINE_LOG_MAX_CHARS=1000
# What a script may import: bytes per file, files and import depth per execution, transpiled files cached
ENGINE_MODULE_MAX_FILE_BYTES=32768
ENGINE_MODULE_MAX_FILES=20
ENGINE_MODULE_MAX_DEPTH=5
ENGINE_MODULE_CACHE_ENTRIES=200
# Unclean engine restarts after which a running script is killed instead of relaunched
ENGINE_MAX_RESTARTS=3
ENGINE_HEALTHY_TICKS=6000
# Chunks of the map the engine keeps in memory
ENGINE_MAX_CHUNKS=512
# Game rules: the most ticks a cell can take however heavy the bot is, and combat (design §8.5, §12.6)
ENGINE_MAX_TICKS_PER_CELL=20
ENGINE_MIN_DAMAGE=1
ENGINE_ACCURACY_FALLOFF=0.5
# The radio network (design §11.2.1): margins of the 4, 3 and 2 signal bars, and what a bot out of reach keeps
ENGINE_RADIO_BAR_MARGINS=0.75,0.5,0.25
ENGINE_RADIO_BUFFER_SCANS=1000
ENGINE_RADIO_BUFFER_EVENTS=200

# Data lifecycle job (docs/operations/DEPLOYMENT.md): runs on the node that owns the engine. Accounts never confirmed are deleted after
# UNVERIFIED_ACCOUNT_DAYS; a free player inactive for INACTIVE_ACCOUNT_DAYS (0 = never) is emailed INACTIVE_ACCOUNT_NOTICE_DAYS
# before the account is erased. Players with running scripts are never inactive.
LIFECYCLE_ENABLED=
LIFECYCLE_INTERVAL_MS=3600000
UNVERIFIED_ACCOUNT_DAYS=7
INACTIVE_ACCOUNT_DAYS=365
INACTIVE_ACCOUNT_NOTICE_DAYS=30
EXECUTION_RETENTION_DAYS=30
AUTH_DATA_RETENTION_DAYS=7
# Days of the activity of players (for the analytics) that are kept
PLAYER_ACTIVITY_RETENTION_DAYS=400

# Terminal log retention (design §11.2.3)
TERMINAL_LOG_RETENTION_DAYS=30
TERMINAL_LOG_MAX_LINES=5000
TERMINAL_SECURITY_RETENTION_DAYS=90

# Notifications of the game (design §24.2): how long they are kept, how long repeated events are coalesced, and the most per category per minute
NOTIFICATION_RETENTION_DAYS=30
NOTIFICATION_COALESCE_MS=30000
NOTIFICATION_CAP_PER_MINUTE=30

# Logs: `json` (one object per line, default in production) or `text`; LOG_FILE=false logs to the console only (containers)
LOG_FORMAT=
LOG_FILE=true
# OpenTelemetry: the OTLP endpoint of the collector gateway for logs and traces (empty: console and files only), the headers sent with
# every export (`authorization=Bearer …`), the share of new traces that are recorded (0 to 1) and the size of the export queue
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_ARG=1
OTEL_EXPORT_QUEUE_SIZE=2048
# Where the admin console's log search reads: `memory` (the recent lines of the node that answers) or `elasticsearch` (every node; the
# account needs read access to the LOG_INDEX data stream only, see docs/operations/DEPLOYMENT.md)
LOG_STORE=memory
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
LOG_INDEX=botrts-logs
TRACE_INDEX=botrts-traces
LOG_SEARCH_TIMEOUT_MS=5000
LOG_SEARCH_MAX_WINDOW_DAYS=7
# Where the admin console reads the health and the queue of the gateway (empty: no gateway metrics); `npm run obs:up` starts a gateway
# on these ports. The gateway checks the bearer token in OTEL_EXPORTER_OTLP_HEADERS against its own OTEL_GATEWAY_TOKEN.
OTEL_GATEWAY_HEALTH_URL=
OTEL_GATEWAY_METRICS_URL=
# Where the admin dashboard's history is kept: `memory` (this process) or `postgres` (the one-minute tier of every node in the database; the
# default in production and with APP_ROLE=api or engine)
MONITORING_HISTORY=
# How many of the newest log lines are kept in memory for the admin console's log search
LOG_BUFFER_SIZE=5000
# Test-only tools of the admin console (test players with bases); refused when NODE_ENV=production
DEV_TOOLS_ENABLED=false
# The JSON file the backup job writes when it finishes ({"finishedAt": "2026-10-15T03:00:00Z", "sizeBytes": 123, "location": "s3://..."}); the Operations page of the console shows it
BACKUP_STATUS_FILE=
# Bearer token of GET /api/v1/metrics (Prometheus); without it the endpoint answers 404
METRICS_TOKEN=

# Scaling the API tier (docs/operations/DEPLOYMENT.md): `all` runs everything in one process; `api` nodes serve HTTP and sockets and reach the
# one `engine` node through Redis. REDIS_URL is required for `api` and `engine`, and also shares Socket.IO rooms between nodes.
APP_ROLE=all
REDIS_URL=
# How long an API node waits for the engine node to answer a request (ms)
ENGINE_REQUEST_TIMEOUT_MS=15000

# Rate limit of signup, login and refresh (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
# Every other route (per IP): requests per window. Counted in Redis when REDIS_URL is set, otherwise per process
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=600

# HTTP limits: the largest JSON body, how long a handler may take before 503 REQUEST_TIMEOUT, and Node's limits against slow clients
HTTP_BODY_LIMIT_BYTES=262144
HTTP_HANDLER_TIMEOUT_MS=30000
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000

# SMTP (host defaults to smtp.gmail.com outside production; required in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# End-to-end tests only: a directory that receives every outgoing email as a JSON file (takes priority over SMTP)
EMAIL_OUTBOX_DIR=

# Root user created on first start
ROOT_USER_EMAIL=root@root.root
ROOT_USER_PASSWORD=

# Bot security (design 11.2.2): energy and time one password attempt on a foreign bot costs, failures in a row that lock the
# bot out, and for how long (ms)
BOT_ATTEMPT_ENERGY=5
BOT_ATTEMPT_DELAY_MS=1000
BOT_LOCKOUT_FAILURES=5
BOT_LOCKOUT_MS=600000

# Admin console (design §25.2). Every admin must enroll TOTP; a session stays verified this long.
ADMIN_2FA_TTL=8h
# Comma-separated addresses the console may be used from (empty: any)
ADMIN_IP_ALLOWLIST=
# The name an authenticator app shows
ADMIN_TOTP_ISSUER=BotRTS
ADMIN_RECOVERY_CODES=8
# How often (ms) bans with a duration are lifted once their time has passed
ADMIN_BAN_CHECK_MS=60000
# How long a "view as player" session lasts at most
ADMIN_VIEW_AS_TTL=30m
# How long (ms) a node keeps the switches of the features of the game before it reads them again; 0 reads every time
FEATURE_SWITCH_CACHE_MS=5000
# Encrypts the TOTP secrets at rest; defaults to JWT_ACCESS_SECRET
ADMIN_SECRET=

# Health monitoring for the admin console (design §25.5): the sampler, the history it keeps in memory, and alerts
MONITORING_ENABLED=
MONITORING_INTERVAL_MS=10000
MONITORING_FINE_RETENTION=7d
MONITORING_COARSE_RETENTION=30d
# Who is emailed about a red alert (comma-separated)
ADMIN_ALERT_EMAILS=
# Overrides of the default thresholds, by metric: {"api.errorRate5xx":{"yellow":0.02,"red":0.1}}
ADMIN_ALERT_THRESHOLDS=
