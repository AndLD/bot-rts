{
  "name": "@bot-rts/api",
  "version": "0.0.0",
  "description": "",
  "main": "ts-built/api/index.js",
  "scripts": {
    "prod": "node ts-built/api/index",
    "dev": "NODE_PATH=./ nodemon index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --ext ts --max-warnings 0",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "db:migrate": "dotenv -e .env.development -- prisma migrate deploy",
    "db:seed": "dotenv -e .env.development -- ts-node prisma/seed.ts",
    "db:migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "openapi:generate": "ts-node scripts/generate-openapi.ts",
    "docs:generate": "ts-node scripts/generate-docs.ts"
  },
  "author": "<Andrii Larionov, andrey.larionov.me@gmail.com>",
  "license": "ISC",
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "dependency-cruiser": "~16.10.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^2.0.19",
    "prisma": "^6.19.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.0.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.1",
    "nodemailer": "^6.9.13",
    "quickjs-emscripten": "^0.32.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.7.5",
    "sucrase": "^3.35.1"
